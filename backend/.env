# --- Code execution engine ---
# In production this should point at an isolated execution service (see
# src/execution/README.md). For local dev the built-in subprocess runner is used directly.
EXECUTION_ENGINE_URL=
EXECUTION_TIMEOUT_MS=8000
# Auto-installs common dependencies the first time code needs them —
# Python (pip), JavaScript/TypeScript (npm), Ruby (gem), PHP (Composer), and
# Go (go mod tidy). See README "Auto-installed dependencies" section for the
# full package lists and why C/C++/Java/Rust aren't covered. Runs before the
# timeout above starts counting, since a first-time install can take 10-30s;
# once installed on this server it stays installed for all future runs.
DEPENDENCY_INSTALL_TIMEOUT_MS=90000
# Where installed dependencies (shared node_modules, gems, vendor/, Go
# module cache) are stored. Defaults to backend/data/shared-deps — put this
# on the same persistent disk as your SQLite database in production, or
# every deploy re-installs everything from scratch.
SHARED_DEPS_DIR=

# --- AI Assistant ---
# Powers the in-app AI chat/code panel. This is a thin proxy to any
# OpenAI-compatible /chat/completions API — works unmodified with OpenAI, or
# with a drop-in-compatible provider (Groq, OpenRouter, Together AI, a local
# Ollama server, etc). See README "AI Assistant" section for genuinely
# free-tier options — OpenAI's own API is pay-per-token, not free.
#
# Concrete free option: Groq (https://console.groq.com/keys) — no credit
# card required, genuinely free, rate-limited (~30 req/min) rather than
# metered by cost. It's OpenAI-compatible, so it's a drop-in here:
#   AI_API_KEY=<your Groq key>
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=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
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_MAX_TOKENS=1024
