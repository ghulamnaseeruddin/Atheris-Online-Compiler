# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Database ---
# SQLite file path. Relative paths resolve from the backend project root.
# Leave unset to use the default: backend/data/atheris.db (auto-created).
SQLITE_DB_PATH=./data/atheris.db

