GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# --- OAuth: Google (create at https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=524858726686-ae07ragcmp2nfiej6qodpt70bp1mnc4u.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
